# 复制为 config/.env 后填写；config/.env 不进版本库
#
# 线上站点只需要这两类环境变量。

# --- 注册验证 / 找回密码 用的邮件服务 ---
RESEND_API_KEY=
DDDB_MAIL_FROM=DDDB <support@example.com>

# --- 站点 ---
# 对外地址（等价于 config.toml 的 [public] base_url）
DNH_PUBLIC_BASE_URL=
# 部署在反向代理后面
DNH_PUBLIC_BEHIND_PROXY=1
# 会话库路径（留空 = 只放内存）
DNH_PUBLIC_SESSIONS_DB=
